# mothershipOS Android build environment (PixelOS / LineageOS / AOSP), Ubuntu 24.04
FROM ubuntu:24.04
ARG UID=1000
ARG GID=1000
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends \
    bc bison build-essential ca-certificates ccache curl flex g++-multilib gcc-multilib git git-lfs gnupg gperf \
    imagemagick lib32readline-dev lib32z1-dev libelf-dev lz4 libsdl1.2-dev libssl-dev libxml2 libxml2-utils lzop \
    pngcrush rsync schedtool squashfs-tools xsltproc zip unzip zlib1g-dev python3 python-is-python3 fontconfig \
    libncurses-dev procps file less openssh-client repo sudo kmod cpio xz-utils \
 && rm -rf /var/lib/apt/lists/*
# reuse the host user id so the tree stays owned by the host user
RUN (getent group $GID || groupadd -g $GID builder) && (id -u $UID >/dev/null 2>&1 && usermod -l builder -d /home/builder -m $(id -nu $UID) || useradd -m -u $UID -g $GID builder) \
 && echo "builder ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/builder
USER builder
ENV USE_CCACHE=1 CCACHE_EXEC=/usr/bin/ccache CCACHE_DIR=/home/builder/.ccache
WORKDIR /home/builder/aosp/PixelOS
