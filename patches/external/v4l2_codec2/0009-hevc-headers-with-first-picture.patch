 }
 
+// mothershipOS: whether an HEVC chunk carries a coded picture (a VCL NAL unit: nal_unit_type 0-31)
+bool hevcHasPicture(const uint8_t* data, size_t size) {
+    HEVCNalParser parser(data, size);
+    while (parser.locateNextNal()) {
+        if (parser.length() == 0) continue;
+        if (parser.type() < 32) return true;
+    }
+    return false;
+}
+
 // mothershipOS: the visible rectangle a bitstream chunk declares, if it has a key frame / SPS (std::nullopt
 // otherwise): H.264/HEVC SPS cropping window, VP9/VP8 key frame size.
