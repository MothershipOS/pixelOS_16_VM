 bool V4L2Decoder::queueMmapInput() {
+    // the view starts at the block's offset (request.buffer->offset)
+    C2ReadView view = mDecodeRequests.front().buffer->dmabuf.map().get();
+    const size_t size = mDecodeRequests.front().buffer->size;
+    if (view.error() != C2_OK || view.capacity() < size) {
+        ALOGE("%s(): cannot map the bitstream (%d)", __func__, view.error());
+        onError();
