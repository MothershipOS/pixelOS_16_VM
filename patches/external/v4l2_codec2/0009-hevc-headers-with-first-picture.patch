+    // HEVC headers without a picture: done at once, they go in front of the next picture
+    if (mCodec == VideoCodec::HEVC && !hevcHasPicture(view.data(), size)) {
+        mHevcPrefix.insert(mHevcPrefix.end(), view.data(), view.data() + size);
+        mHevcHeaders = mHevcPrefix;
+        if (auto rect = findStreamVisibleRect(view.data(), size, mCodec)) {
+            mStreamVisibleRect = rect;
+        }
+        auto request = std::move(mDecodeRequests.front());
