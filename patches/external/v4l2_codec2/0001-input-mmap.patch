+// mothershipOS: queue the front decode request in a MMAP input buffer (the bitstream copied in). false: no free
+// buffer (decoding resumes once one is dequeued) or an error (reported).
+bool V4L2Decoder::queueMmapInput() {
+    std::optional<V4L2WritableBufferRef> inputBuffer = mInputQueue->getFreeBuffer();
+    if (!inputBuffer) {
+        ALOGV("There is no free input buffer.");
+        return false;
+    }
+
+    auto request = std::move(mDecodeRequests.front());
+    mDecodeRequests.pop();
+
+    const int32_t bitstreamId = request.buffer->id;
+    ALOGV("QBUF to input queue (MMAP), bitstreadId=%d", bitstreamId);
+    inputBuffer->setTimeStamp({.tv_sec = bitstreamId});
+    const size_t planeSize = inputBuffer->getPlaneSize(0);
+    if (request.buffer->size > planeSize) {
+        ALOGE("The input size (%zu) is not enough, we need %zu", planeSize, request.buffer->size);
+        onError();
+        return false;
+    }
+    // the view starts at the block's offset (request.buffer->offset)
+    C2ReadView view = request.buffer->dmabuf.map().get();
+    if (view.error() != C2_OK || view.capacity() < request.buffer->size) {
+        ALOGE("%s(): cannot map the bitstream (%d)", __func__, view.error());
+        onError();
+        return false;
+    }
+    void* dst = inputBuffer->getPlaneMapping(0);
+    if (dst == nullptr) {
+        ALOGE("%s(): cannot map input buffer %zu", __func__, inputBuffer->bufferId());
+        onError();
+        return false;
+    }
+    memcpy(dst, view.data(), request.buffer->size);
+    inputBuffer->setPlaneDataOffset(0, 0);
+    inputBuffer->setPlaneBytesUsed(0, request.buffer->size);
+    if (!std::move(*inputBuffer).queueMMap()) {
+        ALOGE("%s(): Failed to QBUF to input queue, bitstreamId=%d", __func__, bitstreamId);
+        onError();
+        return false;
+    }
+
+    mPendingDecodeCbs.insert(std::make_pair(bitstreamId, std::move(request.decodeCb)));
+    return true;
+}
