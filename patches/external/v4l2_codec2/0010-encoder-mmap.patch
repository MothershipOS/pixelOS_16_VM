+// mothershipOS: copy an input frame (dma-bufs, any stride) into a MMAP input buffer (the device's layout). The
+// encoder is the host's Venus through virtio-media, which can only share virtio objects (virtio-gpu buffers) as
+// DMABUFs; the client's frames (and the format converter's) come from dma-buf heaps.
+bool V4L2Encoder::copyInputFrame(const InputFrame& frame, V4L2WritableBufferRef& buffer) {
+    const auto& planes = frame.planes();
+    const auto& fds = frame.fds();
+    const auto format = frame.pixelFormat();
+    std::vector<std::pair<void*, size_t>> maps;
+    bool ok = true;
+    for (size_t i = 0; ok && i < planes.size(); ++i) {
+        int fd = fds[std::min(i, fds.size() - 1)];
+        // one mapping per distinct fd
+        if (i > 0 && fds.size() <= i) {
+            maps.push_back(maps.back());
+            continue;
+        }
+        off_t size = lseek(fd, 0, SEEK_END);
+        void* src = size > 0 ? mmap(nullptr, size, PROT_READ, MAP_SHARED, fd, 0) : MAP_FAILED;
+        if (src == MAP_FAILED) {
+            ALOGE("%s(): cannot map input plane %zu (fd %d)", __func__, i, fd);
+            ok = false;
+            break;
+        }
+        struct dma_buf_sync sync = {.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ};
+        ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+        maps.push_back({src, static_cast<size_t>(size)});
+    }
+    for (size_t i = 0; ok && i < planes.size(); ++i) {
+        const size_t dstPlane = mInputLayout->mMultiPlanar ? i : 0;
+        uint8_t* dst = static_cast<uint8_t*>(buffer.getPlaneMapping(dstPlane));
+        if (dst == nullptr) {
+            ALOGE("%s(): cannot map device input plane %zu", __func__, dstPlane);
+            ok = false;
+            break;
+        }
+        if (!mInputLayout->mMultiPlanar) dst += mInputLayout->mPlanes[i].mOffset;
+        const size_t dstStride = mInputLayout->mPlanes[i].mStride;
+        const size_t srcStride = planes[i].mStride;
+        const ui::Size rows = planeSize(format, i, mInputLayout->mCodedSize);
+        const size_t rowBytes = std::min({static_cast<size_t>(rows.width), srcStride, dstStride});
+        const uint8_t* src = static_cast<const uint8_t*>(maps[i].first) + planes[i].mOffset;
+        const size_t avail = maps[i].second - std::min(maps[i].second, static_cast<size_t>(planes[i].mOffset));
+        for (int32_t y = 0; y < rows.height && static_cast<size_t>(y) * srcStride + rowBytes <= avail; ++y) {
+            memcpy(dst + y * dstStride, src + y * srcStride, rowBytes);
+        }
+    }
+    for (size_t i = 0; i < maps.size(); ++i) {
+        if (i > 0 && maps[i].first == maps[i - 1].first) continue;
+        struct dma_buf_sync sync = {.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ};
+        ioctl(fds[std::min(i, fds.size() - 1)], DMA_BUF_IOCTL_SYNC, &sync);
+        munmap(maps[i].first, maps[i].second);
+    }
+    if (!ok) return false;
+    if (mInputLayout->mMultiPlanar) {
+        for (size_t i = 0; i < planes.size(); ++i) {
+            buffer.setPlaneDataOffset(i, 0);
+            buffer.setPlaneBytesUsed(
+                    i, ::base::checked_cast<size_t>(
+                               getArea(planeSize(format, i, mInputLayout->mCodedSize)).value()));
+        }
+    } else {
+        buffer.setPlaneDataOffset(0, 0);
+        buffer.setPlaneBytesUsed(0, allocationSize(format, mInputLayout->mCodedSize));
+    }
+    return true;
+}
