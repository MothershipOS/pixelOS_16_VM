+// mothershipOS: whether a frame can go to the device as it is: a virtio-gpu buffer (virtio-media can share only
+// those with the host) whose planes are where the device expects them (single-planar, its strides and offsets: a
+// mothershipOS host's NV12 gralloc buffers have the Venus layout). The first fd is the buffer (a gralloc handle has
+// one fd per plane, all of the same buffer).
+bool V4L2Encoder::directInput(const InputFrame& frame) const {
+    const auto& fds = frame.fds();
+    const auto& planes = frame.planes();
+    if (mInputLayout->mMultiPlanar || fds.empty() || planes.size() != mInputLayout->mPlanes.size()) {
+        ALOGI("%s(): no: multi-planar %d, %zu fds, %zu planes (device %zu)", __func__, mInputLayout->mMultiPlanar,
+              fds.size(), planes.size(), mInputLayout->mPlanes.size());
+        return false;
+    }
+    for (size_t i = 0; i < planes.size(); ++i) {
+        if (planes[i].mOffset != mInputLayout->mPlanes[i].mOffset ||
+            planes[i].mStride != mInputLayout->mPlanes[i].mStride) {
+            ALOGI("%s(): no: plane %zu at %u stride %u, the device's at %zu stride %zu", __func__, i,
+                  static_cast<uint32_t>(planes[i].mOffset), static_cast<uint32_t>(planes[i].mStride),
+                  static_cast<size_t>(mInputLayout->mPlanes[i].mOffset),
+                  static_cast<size_t>(mInputLayout->mPlanes[i].mStride));
+            return false;
+        }
+    }
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fds[0]);
+    FILE* f = fopen(path, "re");
+    if (f == nullptr) return false;
+    char line[128];
+    bool virtio = false;
+    while (fgets(line, sizeof(line), f) != nullptr) {
+        if (strncmp(line, "exp_name:", 9) == 0) {
+            virtio = strstr(line, "virtio_gpu") != nullptr;
+            break;
+        }
+    }
+    fclose(f);
+    if (!virtio) ALOGI("%s(): no: not a virtio-gpu buffer", __func__);
+    return virtio;
+}
