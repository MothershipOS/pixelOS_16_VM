+bool H264NalParser::findVisibleRect(uint32_t* left, uint32_t* top, uint32_t* width,
+                                    uint32_t* height) {
+    ALOG_ASSERT(type() == kSPSType);
+    NALBitReader br(mCurrNalDataPos + 1, length() - 1);
+
+    uint32_t unused;
+    uint32_t profileIDC;
+    if (!br.getBitsGraceful(8, &profileIDC)) return false;  // profile_idc
+    br.skipBits(16);        // constraint flags + reserved bits + level_idc
+    parseUE(&br, &unused);  // seq_parameter_set_id
+
+    uint32_t chromaFormatIDC = 1;
+    uint32_t separateColourPlane = 0;
+    if (profileIDC == kProfileIDCHigh || profileIDC == kProfileIDHigh10 ||
+        profileIDC == kProfileIDHigh422 || profileIDC == kProfileIDHigh444Predictive ||
+        profileIDC == kProfileIDCAVLC444 || profileIDC == kProfileIDScalableBaseline ||
+        profileIDC == kProfileIDScalableHigh || profileIDC == kProfileIDSMultiviewHigh ||
+        profileIDC == kProfileIDStereoHigh) {
+        if (!parseUE(&br, &chromaFormatIDC)) return false;
+        if (chromaFormatIDC == kYUV444Idc) {
+            if (!br.getBitsGraceful(1, &separateColourPlane)) return false;
+        }
+        parseUE(&br, &unused);  // bit_depth_luma_minus8
+        parseUE(&br, &unused);  // bit_depth_chroma_minus8
+        br.skipBits(1);         // lossless_qpprime_y_zero_flag
+        uint32_t seqScalingMatrixPresentFlag;
+        if (!br.getBitsGraceful(1, &seqScalingMatrixPresentFlag)) return false;
+        if (seqScalingMatrixPresentFlag) {
+            const size_t numScalingLists = (chromaFormatIDC != kYUV444Idc) ? 8 : 12;
+            if (!skipScalingMatrix(&br, numScalingLists)) return false;
+        }
+    }
+
+    parseUE(&br, &unused);  // log2_max_frame_num_minus4
+    uint32_t pictureOrderCountType;
+    if (!parseUE(&br, &pictureOrderCountType)) return false;
+    if (pictureOrderCountType == 0) {
+        parseUE(&br, &unused);  // log2_max_pic_order_cnt_lsb_minus4
+    } else if (pictureOrderCountType == 1) {
+        br.skipBits(1);  // delta_pic_order_always_zero_flag
+        int32_t unused_i;
+        parseSE(&br, &unused_i);  // offset_for_non_ref_pic
+        parseSE(&br, &unused_i);  // offset_for_top_to_bottom_field
+        uint32_t numReferenceFrames;
+        if (!parseUE(&br, &numReferenceFrames)) return false;
+        for (uint32_t i = 0; i < numReferenceFrames; ++i) parseUE(&br, &unused);
+    }
+    parseUE(&br, &unused);  // num_ref_frames
+    br.skipBits(1);         // gaps_in_frame_num_value_allowed_flag
+    uint32_t widthInMbsMinus1, heightInMapUnitsMinus1, frameMbsOnlyFlag;
+    if (!parseUE(&br, &widthInMbsMinus1)) return false;
+    if (!parseUE(&br, &heightInMapUnitsMinus1)) return false;
+    if (!br.getBitsGraceful(1, &frameMbsOnlyFlag)) return false;
+    if (!frameMbsOnlyFlag) br.skipBits(1);  // mb_adaptive_frame_field_flag
+    br.skipBits(1);                         // direct_8x8_inference_flag
+
+    const uint32_t codedWidth = (widthInMbsMinus1 + 1) * 16;
+    const uint32_t codedHeight = (2 - frameMbsOnlyFlag) * (heightInMapUnitsMinus1 + 1) * 16;
+    uint32_t cropLeft = 0, cropRight = 0, cropTop = 0, cropBottom = 0;
+    uint32_t frameCroppingFlag;
+    if (!br.getBitsGraceful(1, &frameCroppingFlag)) return false;
+    if (frameCroppingFlag) {
+        if (!parseUE(&br, &cropLeft) || !parseUE(&br, &cropRight) || !parseUE(&br, &cropTop) ||
+            !parseUE(&br, &cropBottom))
+            return false;
+    }
+    // crop units (H.264 7.4.2.1.1): 4:2:0 -> 2x2, 4:2:2 -> 2x1, 4:4:4/monochrome -> 1x1; fields double y
+    const uint32_t chroma = separateColourPlane ? 0 : chromaFormatIDC;
+    const uint32_t unitX = (chroma == 1 || chroma == 2) ? 2 : 1;
+    const uint32_t unitY = ((chroma == 1) ? 2 : 1) * (2 - frameMbsOnlyFlag);
+    if ((cropLeft + cropRight) * unitX >= codedWidth || (cropTop + cropBottom) * unitY >= codedHeight)
+        return false;
+    *left = cropLeft * unitX;
+    *top = cropTop * unitY;
+    *width = codedWidth - (cropLeft + cropRight) * unitX;
+    *height = codedHeight - (cropTop + cropBottom) * unitY;
+    return true;
+}
