+// mothershipOS: the visible rectangle a bitstream chunk declares, if it has a key frame / SPS (std::nullopt
+// otherwise): H.264/HEVC SPS cropping window, VP9/VP8 key frame size.
+std::optional<Rect> findStreamVisibleRect(const uint8_t* data, size_t size, VideoCodec codec) {
+    uint32_t left = 0, top = 0, width = 0, height = 0;
+    switch (codec) {
+    case VideoCodec::H264: {
+        H264NalParser parser(data, size);
+        if (!parser.locateSPS() || !parser.findVisibleRect(&left, &top, &width, &height))
+            return std::nullopt;
+        break;
+    }
+    case VideoCodec::HEVC: {
+        HEVCNalParser parser(data, size);
+        if (!parser.locateSPS() || !parser.findVisibleRect(&left, &top, &width, &height))
+            return std::nullopt;
+        break;
+    }
+    case VideoCodec::VP9: {
+        // uncompressed header (VP9 spec 6.2): frame_marker(2) profile(2) [reserved(1) if profile 3]
+        // show_existing_frame(1) frame_type(1) show_frame(1) error_resilient_mode(1), then for key frames the
+        // sync code 0x498342, color_config and frame_width_minus_1(16) frame_height_minus_1(16)
+        if (size < 12) return std::nullopt;
+        size_t bit = 0;
+        auto get = [&](int n) {
+            uint32_t v = 0;
+            for (int i = 0; i < n; i++, bit++) v = (v << 1) | ((data[bit / 8] >> (7 - bit % 8)) & 1);
+            return v;
+        };
+        if (get(2) != 2) return std::nullopt;  // frame_marker
+        const uint32_t profileLow = get(1);
+        const uint32_t profile = (get(1) << 1) | profileLow;
+        if (profile == 3) get(1);
+        if (get(1)) return std::nullopt;  // show_existing_frame
+        if (get(1) != 0) return std::nullopt;  // frame_type: not a key frame
+        get(2);  // show_frame, error_resilient_mode
+        if (get(24) != 0x498342) return std::nullopt;
+        if (profile >= 2) get(1);  // ten_or_twelve_bit
+        const uint32_t colorSpace = get(3);
+        if (colorSpace != 7) {  // not CS_RGB
+            get(1);             // color_range
+            if (profile == 1 || profile == 3) get(3);  // subsampling_x, subsampling_y, reserved
+        } else if (profile == 1 || profile == 3) {
+            get(1);  // reserved
+        }
+        if ((bit + 32 + 7) / 8 > size) return std::nullopt;
+        width = get(16) + 1;
+        height = get(16) + 1;
+        break;
+    }
+    case VideoCodec::VP8: {
+        // frame tag (3 bytes, bit 0: 0 = key frame), start code 9d 01 2a, 14-bit width and height (little endian)
+        if (size < 10 || (data[0] & 1) != 0) return std::nullopt;
+        if (data[3] != 0x9d || data[4] != 0x01 || data[5] != 0x2a) return std::nullopt;
+        width = (data[6] | (data[7] << 8)) & 0x3fff;
+        height = (data[8] | (data[9] << 8)) & 0x3fff;
+        break;
+    }
+    }
+    if (width == 0 || height == 0) return std::nullopt;
+    return Rect(left, top, left + width, top + height);
+}
