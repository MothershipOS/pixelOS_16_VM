+bool HEVCNalParser::findVisibleRect(uint32_t* left, uint32_t* top, uint32_t* width,
+                                    uint32_t* height) {
+    ALOG_ASSERT(type() == kSPSType);
+    if (length() <= 2) return false;
+    NALBitReader br(mCurrNalDataPos + 2, length() - 2);
+
+    br.skipBits(4);  // sps_video_parameter_set_id
+    uint32_t spsMaxSublayersMinus1;
+    if (!br.getBitsGraceful(3, &spsMaxSublayersMinus1)) return false;
+    br.skipBits(1);  // sps_temporal_id_nesting_flag
+    if (!skipProfileTierLevel(&br, spsMaxSublayersMinus1)) return false;
+
+    uint32_t unused;
+    parseUE(&br, &unused);  // sps_seq_parameter_set_id
+    uint32_t chromaFormatIdc;
+    if (!parseUE(&br, &chromaFormatIdc)) return false;
+    uint32_t separateColourPlane = 0;
+    if (chromaFormatIdc == 3 && !br.getBitsGraceful(1, &separateColourPlane)) return false;
+    uint32_t codedWidth, codedHeight;
+    if (!parseUE(&br, &codedWidth) || !parseUE(&br, &codedHeight)) return false;
+
+    uint32_t confLeft = 0, confRight = 0, confTop = 0, confBottom = 0;
+    uint32_t conformanceWindowFlag;
+    if (!br.getBitsGraceful(1, &conformanceWindowFlag)) return false;
+    if (conformanceWindowFlag) {
+        if (!parseUE(&br, &confLeft) || !parseUE(&br, &confRight) || !parseUE(&br, &confTop) ||
+            !parseUE(&br, &confBottom))
+            return false;
+    }
+    // SubWidthC/SubHeightC (HEVC table 6-1)
+    const uint32_t chroma = separateColourPlane ? 0 : chromaFormatIdc;
+    const uint32_t unitX = (chroma == 1 || chroma == 2) ? 2 : 1;
+    const uint32_t unitY = (chroma == 1) ? 2 : 1;
+    if ((confLeft + confRight) * unitX >= codedWidth || (confTop + confBottom) * unitY >= codedHeight)
+        return false;
+    *left = confLeft * unitX;
+    *top = confTop * unitY;
+    *width = codedWidth - (confLeft + confRight) * unitX;
+    *height = codedHeight - (confTop + confBottom) * unitY;
+    return true;
+}
