+void VsyncThread::presented(TimePoint presented) {
+    std::unique_lock<std::mutex> lock(mStateMutex);
+    const auto period = mVsyncPeriod;
+    if (period.count() <= 0) {
+        return;
+    }
+    // presented - the vsync grid, wrapped into [-period/2, period/2)
+    auto error = Nanoseconds(presented - mPreviousVsync) % period;
+    if (error < Nanoseconds(0)) {
+        error += period;
+    }
+    if (error >= period / 2) {
+        error -= period;
+    }
+    // low-pass: present times carry the host's wakeup jitter
+    mPhaseCorrection = error / 4;
+}
