+    HWC3::Error error = mComposer->presentDisplay(this, outDisplayFence, outLayerFences);
+    // the commit blocks until the flip completes: its out fence has signaled at the present time
+    if (error == HWC3::Error::None && outDisplayFence->ok()) {
+        if (struct sync_file_info* info = sync_file_info(outDisplayFence->get())) {
+            if (info->status == 1 && info->num_fences > 0) {
+                const struct sync_fence_info* fences = sync_get_fence_info(info);
+                uint64_t presented = 0;
+                for (uint32_t i = 0; i < info->num_fences; i++) {
+                    presented = std::max<uint64_t>(presented, fences[i].timestamp_ns);
+                }
+                mVsyncThread.presented(asTimePoint(static_cast<int64_t>(presented)));
+            }
+            sync_file_info_free(info);
+        }
+    }
+    return error;
 }
 
