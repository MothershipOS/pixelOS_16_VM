--- a/hals/sensors/multihal_sensors.cpp
+++ b/hals/sensors/multihal_sensors.cpp
@@ -173,9 +173,36 @@
     } else {
         m_activeSensorsMask = m_activeSensorsMask & ~(1u << sensorHandle);
     }
+    // the host streams only what is active, at the rate the active sensors need (a phone's sensors cost power;
+    // a stub transport before the listener thread connects: it sends the active set when it does)
+    setSensorsReportingImpl(*m_sensorsTransport, sensorHandle, enabled);
+    updateSensorsUpdateIntervalLocked();
     return Result::OK;
 }
 
+void MultihalSensors::updateSensorsUpdateIntervalLocked() {
+    // streaming sensors only: an on-change sensor's sampling period does not set the host's interval
+    auto minSamplingPeriodNs = kMaxSamplingPeriodNs;
+    for (int h = 0; h < int(m_batchInfo.size()); ++h) {
+        const SensorInfo* sensor = getSensorInfoByHandle(h);
+        if ((m_activeSensorsMask & (1u << h)) && sensor && isContiniousReportingSensor(sensor->flags)) {
+            const auto periodNs = m_batchInfo[h].samplingPeriodNs;
+            if ((periodNs > 0) && (periodNs < minSamplingPeriodNs)) {
+                minSamplingPeriodNs = periodNs;
+            }
+        }
+    }
+
+    const uint32_t sensorsUpdateIntervalMs = std::max(1, int(minSamplingPeriodNs / 1000000));
+    if (sensorsUpdateIntervalMs == m_protocolState.sensorsUpdateIntervalMs) {
+        return;
+    }
+    m_protocolState.sensorsUpdateIntervalMs = sensorsUpdateIntervalMs;
+    if (!setSensorsUpdateIntervalMs(*m_sensorsTransport, sensorsUpdateIntervalMs)) {
+        qemuSensorThreadSendCommand(kCMD_RESTART);
+    }
+}
