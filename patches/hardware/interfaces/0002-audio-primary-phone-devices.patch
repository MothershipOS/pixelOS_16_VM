+// mothershipOS: wired (analog jack) devices are connected by the framework; their streams use the
+// mix ports' static profiles, the PCM is chosen by device type (StreamPrimary).
+ndk::ScopedAStatus ModulePrimary::populateConnectedDevicePort(AudioPort* audioPort, int32_t) {
+    if (audioPort->ext.getTag() != AudioPortExt::device) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    }
+    const auto& connection = audioPort->ext.get<AudioPortExt::device>().device.type.connection;
+    if (!connection.empty() &&
+        connection != ::aidl::android::media::audio::common::AudioDeviceDescription::CONNECTION_ANALOG) {
+        LOG(ERROR) << __func__ << ": unsupported connection: " << audioPort->toString();
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+    }
+    return ndk::ScopedAStatus::ok();
+}
