+const std::array<uint32_t, /*size*/ 3> kSupportedFourCCs{
+        {V4L2_PIX_FMT_MJPEG, V4L2_PIX_FMT_Z16, V4L2_PIX_FMT_XBGR32}};  // double braces required in C++11
 
