+ndk::ScopedAStatus ExternalCameraDevice::setTorchMode(bool on) {
+    // mothershipOS: the host's flash LED as a torch (V4L2_CID_FLASH_LED_MODE)
+    unique_fd fd(::open(mDevicePath.c_str(), O_RDWR));
+    if (fd.get() < 0 || !hostControl(fd.get(), V4L2_CID_FLASH_LED_MODE)) {
+        return fromStatus(Status::OPERATION_NOT_SUPPORTED);
+    }
+    v4l2_control c{.id = V4L2_CID_FLASH_LED_MODE,
+                   .value = on ? V4L2_FLASH_LED_MODE_TORCH : V4L2_FLASH_LED_MODE_NONE};
+    if (ioctl(fd.get(), VIDIOC_S_CTRL, &c) != 0) {
+        return fromStatus(Status::INTERNAL_ERROR);
+    }
+    return fromStatus(Status::OK);
 }
 
