+// mothershipOS: whether a device control is real (present, not inactive/disabled)
+bool hostControl(int fd, uint32_t id) {
+    v4l2_queryctrl q{.id = id};
+    return ioctl(fd, VIDIOC_QUERYCTRL, &q) == 0 &&
+           !(q.flags & (V4L2_CTRL_FLAG_DISABLED | V4L2_CTRL_FLAG_INACTIVE));
+}
+
+// mothershipOS: append keys to a characteristics key list (request, result or characteristics keys)
+void appendKeys(::android::hardware::camera::common::V1_0::helper::CameraMetadata* m, uint32_t list,
+                std::initializer_list<int32_t> keys) {
+    camera_metadata_entry e = m->find(list);
+    std::vector<int32_t> v(e.data.i32, e.data.i32 + e.count);
+    v.insert(v.end(), keys.begin(), keys.end());
+    m->update(list, v.data(), v.size());
+}
+
+// mothershipOS: focus and light of a mothershipOS host's camera (its standard V4L2 focus and flash controls,
+// carried out by the host: lens actuator, autofocus, flash LEDs). A device without them keeps the fixed-focus,
+// no-flash characteristics.
+void updateHostControls(int fd, ::android::hardware::camera::common::V1_0::helper::CameraMetadata* m) {
+    if (hostControl(fd, V4L2_CID_FOCUS_AUTO)) {
+        const uint8_t afModes[] = {ANDROID_CONTROL_AF_MODE_OFF, ANDROID_CONTROL_AF_MODE_AUTO,
+                                   ANDROID_CONTROL_AF_MODE_CONTINUOUS_VIDEO,
+                                   ANDROID_CONTROL_AF_MODE_CONTINUOUS_PICTURE};
+        m->update(ANDROID_CONTROL_AF_AVAILABLE_MODES, afModes, sizeof(afModes));
+        const float minFocus = kHostMinFocusDiopters;
+        m->update(ANDROID_LENS_INFO_MINIMUM_FOCUS_DISTANCE, &minFocus, 1);
+        appendKeys(m, ANDROID_REQUEST_AVAILABLE_REQUEST_KEYS, {ANDROID_LENS_FOCUS_DISTANCE});
+        appendKeys(m, ANDROID_REQUEST_AVAILABLE_RESULT_KEYS, {ANDROID_LENS_FOCUS_DISTANCE, ANDROID_LENS_STATE});
+        appendKeys(m, ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS, {ANDROID_LENS_INFO_MINIMUM_FOCUS_DISTANCE});
+        // one AF region: camera apps offer tap to focus only with one (the host focuses on the frame's centre)
+        camera_metadata_entry r = m->find(ANDROID_CONTROL_MAX_REGIONS);
+        if (r.count == 3) {
+            const int32_t regions[3] = {r.data.i32[0], r.data.i32[1], 1};
+            m->update(ANDROID_CONTROL_MAX_REGIONS, regions, 3);
+        }
+        ALOGI("%s: focus control (manual, auto, continuous)", __FUNCTION__);
+    }
+    if (hostControl(fd, V4L2_CID_FLASH_LED_MODE)) {
+        const uint8_t flash = ANDROID_FLASH_INFO_AVAILABLE_TRUE;
+        m->update(ANDROID_FLASH_INFO_AVAILABLE, &flash, 1);
+        const uint8_t aeModes[] = {ANDROID_CONTROL_AE_MODE_ON, ANDROID_CONTROL_AE_MODE_ON_AUTO_FLASH,
+                                   ANDROID_CONTROL_AE_MODE_ON_ALWAYS_FLASH};
+        m->update(ANDROID_CONTROL_AE_AVAILABLE_MODES, aeModes, sizeof(aeModes));
+        ALOGI("%s: flash and torch", __FUNCTION__);
+    }
+}
