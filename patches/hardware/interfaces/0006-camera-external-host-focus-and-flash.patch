+// mothershipOS: set a host camera control when its value changes
+void ExternalCameraDeviceSession::setHostControl(uint32_t id, int value, int* cache) {
+    if (*cache == value) return;
+    v4l2_control c{.id = id, .value = value};
+    if (ioctl(mV4l2Fd.get(), VIDIOC_S_CTRL, &c) == 0) {
+        *cache = value;
+    } else {
+        ALOGW("%s: control 0x%x = %d: %s", __FUNCTION__, id, value, strerror(errno));
+    }
+}
+
+static uint8_t settingU8(const common::V1_0::helper::CameraMetadata& s, uint32_t tag, uint8_t def) {
+    camera_metadata_ro_entry e = s.find(tag);
+    return e.count ? e.data.u8[0] : def;
+}
+
+// mothershipOS: a request's focus and flash settings to the host camera's controls
+void ExternalCameraDeviceSession::applyHostControls(const common::V1_0::helper::CameraMetadata& s) {
+    std::lock_guard<std::mutex> lk(mAfTriggerLock);
+    if (mHostFocus) {
+        uint8_t mode = settingU8(s, ANDROID_CONTROL_AF_MODE, ANDROID_CONTROL_AF_MODE_CONTINUOUS_PICTURE);
+        uint8_t trigger = settingU8(s, ANDROID_CONTROL_AF_TRIGGER, ANDROID_CONTROL_AF_TRIGGER_IDLE);
+        bool continuous = mode == ANDROID_CONTROL_AF_MODE_CONTINUOUS_PICTURE ||
+                          mode == ANDROID_CONTROL_AF_MODE_CONTINUOUS_VIDEO;
+        if (mode != mAfMode) {
+            mAfMode = mode;
+            mAfLocked = mAfRun = false;
+        }
+        bool start = false;
+        if (trigger == ANDROID_CONTROL_AF_TRIGGER_START) {
+            if (continuous) {
+                mAfLocked = true;
+            } else if (mode == ANDROID_CONTROL_AF_MODE_AUTO) {
+                mAfRun = start = true;
+            }
+        } else if (trigger == ANDROID_CONTROL_AF_TRIGGER_CANCEL) {
+            mAfLocked = mAfRun = false;
+        }
+        setHostControl(V4L2_CID_FOCUS_AUTO, continuous && !mAfLocked ? 1 : 0, &mFocusAuto);
+        if (mode == ANDROID_CONTROL_AF_MODE_OFF) {
+            camera_metadata_ro_entry d = s.find(ANDROID_LENS_FOCUS_DISTANCE);
+            float diopters = d.count ? d.data.f[0] : 0.0f;
+            int pos = static_cast<int>(diopters / kHostMinFocusDiopters * 1023.0f + 0.5f);
+            setHostControl(V4L2_CID_FOCUS_ABSOLUTE, std::clamp(pos, 0, 1023), &mFocusPos);
+        } else {
+            mFocusPos = -1;
+        }
+        if (start) {
+            // busy until the host reports the run's end
+            v4l2_control c{.id = V4L2_CID_AUTO_FOCUS_STATUS, .value = V4L2_AUTO_FOCUS_STATUS_BUSY};
+            ioctl(mV4l2Fd.get(), VIDIOC_S_CTRL, &c);
+            c = {.id = V4L2_CID_AUTO_FOCUS_START, .value = 0};
+            ioctl(mV4l2Fd.get(), VIDIOC_S_CTRL, &c);
+        }
+    }
+    if (mHostFlash) {
+        uint8_t flash = settingU8(s, ANDROID_FLASH_MODE, ANDROID_FLASH_MODE_OFF);
+        uint8_t ae = settingU8(s, ANDROID_CONTROL_AE_MODE, ANDROID_CONTROL_AE_MODE_ON);
+        uint8_t pre = settingU8(s, ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER,
+                                ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER_IDLE);
+        uint8_t intent = settingU8(s, ANDROID_CONTROL_CAPTURE_INTENT, ANDROID_CONTROL_CAPTURE_INTENT_PREVIEW);
+        // the host has no light measurement for the decision: auto flash fires like always flash
+        bool flashAe = ae == ANDROID_CONTROL_AE_MODE_ON_ALWAYS_FLASH ||
+                       ae == ANDROID_CONTROL_AE_MODE_ON_AUTO_FLASH;
+        if (flashAe && pre == ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER_START) {
+            mFlashHold = 90;  // until the capture comes (up to ~3 s)
+        } else if (intent == ANDROID_CONTROL_CAPTURE_INTENT_STILL_CAPTURE &&
+                   (flashAe || flash == ANDROID_FLASH_MODE_SINGLE)) {
+            mFlashHold = std::max(std::min(mFlashHold, 10), 10);  // the capture, and a few frames after
+        } else if (mFlashHold > 0) {
+            mFlashHold--;
+        }
+        bool on = flash == ANDROID_FLASH_MODE_TORCH || mFlashHold > 0;
+        setHostControl(V4L2_CID_FLASH_LED_MODE, on ? V4L2_FLASH_LED_MODE_TORCH : V4L2_FLASH_LED_MODE_NONE,
+                       &mLed);
+    }
+}
