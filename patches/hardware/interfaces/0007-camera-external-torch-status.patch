mothershipOS: the external camera provider reports a device's torch changes (setTorchMode, patch 0006) to the camera
service (torchModeStatusChange). Without it the service never learns the torch is on, and the flashlight tile
only ever turns it on.

diff -ru a/camera/device/default/ExternalCameraDevice.cpp b/camera/device/default/ExternalCameraDevice.cpp
--- a/camera/device/default/ExternalCameraDevice.cpp	2026-11-19 22:08:17.405268031 +0000
+++ b/camera/device/default/ExternalCameraDevice.cpp	2026-11-19 22:08:17.428268663 +0000
@@ -250,6 +250,7 @@
     if (ioctl(fd.get(), VIDIOC_S_CTRL, &c) != 0) {
         return fromStatus(Status::INTERNAL_ERROR);
     }
+    if (mTorchCb) mTorchCb(on);
     return fromStatus(Status::OK);
 }
 
