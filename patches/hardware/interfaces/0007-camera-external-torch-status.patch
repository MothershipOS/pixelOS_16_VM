+    // mothershipOS: the device's torch (setTorchMode) reported to the camera service, which otherwise never
+    // learns the torch is on (the flashlight tile would only ever turn it on)
+    {
+        std::shared_ptr<ICameraProviderCallback> cb = mCallback;
+        std::string name = in_cameraDeviceName;
+        deviceImpl->setTorchCallback([cb, name](bool on) {
+            using ::aidl::android::hardware::camera::common::TorchModeStatus;
+            if (cb != nullptr) {
+                cb->torchModeStatusChange(name, on ? TorchModeStatus::AVAILABLE_ON
+                                                   : TorchModeStatus::AVAILABLE_OFF);
+            }
+        });
+    }
+
