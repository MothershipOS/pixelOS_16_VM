+// mothershipOS: our own NV12 capture buffers, up to count (the first one learns the layout). Gralloc gives
+// camera-written YCbCr_420_888 as NV12 (on a mothershipOS host: the Venus layout, linear).
+int ExternalCameraDeviceSession::allocCaptureBuffersLocked(const SupportedV4L2Format& v4l2Fmt, size_t count) {
+    const uint64_t usage = GRALLOC_USAGE_HW_CAMERA_WRITE | GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_SW_READ_OFTEN;
+    while (mCaptureBuffers.size() < count) {
+        sp<GraphicBuffer> gb = sp<GraphicBuffer>::make(v4l2Fmt.width, v4l2Fmt.height,
+                                                       HAL_PIXEL_FORMAT_YCbCr_420_888, 1, usage,
+                                                       "ExternalCameraCapture");
+        if (gb->initCheck() != OK || gb->handle == nullptr || gb->handle->numFds < 1) {
+            ALOGW("%s: cannot allocate a %ux%u capture buffer", __FUNCTION__, v4l2Fmt.width, v4l2Fmt.height);
+            return -ENOMEM;
+        }
+        const int fd = gb->handle->data[0];
+        const off_t length = lseek(fd, 0, SEEK_END);
+        struct stat st;
+        if (length <= 0 || fstat(fd, &st) != 0) return -EINVAL;
+        if (mCaptureBuffers.empty()) {
+            void* base = nullptr;
+            android_ycbcr y{};
+            if (gb->lock(GRALLOC_USAGE_SW_READ_OFTEN, &base) != OK) return -EINVAL;
+            gb->unlock();
+            if (gb->lockYCbCr(GRALLOC_USAGE_SW_READ_OFTEN, &y) != OK) return -EINVAL;
+            gb->unlock();
+            if (base == nullptr || y.y != base || y.chroma_step != 2 || y.cr <= y.cb || y.cstride != y.ystride) {
+                ALOGW("%s: the capture buffers are not NV12", __FUNCTION__);
+                return -EINVAL;
+            }
+            mV4l2Stride = static_cast<uint32_t>(y.ystride);
+            mV4l2ChromaOffset = static_cast<uint32_t>(static_cast<uint8_t*>(y.cb) - static_cast<uint8_t*>(base));
+        }
+        mCaptureBuffers.push_back({gb, fd, static_cast<uint32_t>(length), static_cast<uint64_t>(st.st_ino)});
+    }
+    return 0;
+}
