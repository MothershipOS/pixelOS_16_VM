diff -ruN a/camera/device/default/ExternalCameraGpu.cpp b/camera/device/default/ExternalCameraGpu.cpp
--- a/camera/device/default/ExternalCameraGpu.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/camera/device/default/ExternalCameraGpu.cpp	2026-11-20 12:55:37.777521482 +0000
@@ -0,0 +1,345 @@
+/*
+ * mothershipOS: the external camera HAL's per-stream conversion on the GPU (see ExternalCameraGpu.h).
+ */
+
+#define LOG_TAG "ExtCamGpu"
+
+#include "ExternalCameraGpu.h"
+
+#include <drm/drm_fourcc.h>
+#include <log/log.h>
+
+#include <string>
+
+namespace android {
+namespace hardware {
+namespace camera {
+namespace device {
+namespace implementation {
+
+namespace {
+
+// a full-screen triangle; texture coordinates over the crop rect (y down: the frame's first row on top)
+const char* kVertex = R"(#version 300 es
+uniform vec4 uCrop;  // x0, y0, x1, y1 in normalized source coordinates
+out highp vec2 vUv;
+void main() {
+    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
+    vUv = mix(uCrop.xy, uCrop.zw, p);
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)";
+
+// the source texture holds B, G, R, X in r, g, b, a (XBGR32 uploaded as RGBA)
+const char* kLuma = R"(#version 300 es
+precision highp float;
+uniform sampler2D uSrc;
+in highp vec2 vUv;
+out vec4 oColor;
+void main() {
+    vec3 rgb = texture(uSrc, vUv).bgr;
+    float y = dot(rgb, vec3(0.2578125, 0.50390625, 0.09765625)) + 16.0 / 255.0;
+    oColor = vec4(y, 0.0, 0.0, 1.0);
+}
+)";
+
+// half size: the bilinear sample at a chroma pixel's centre averages the 2x2 source pixels under it
+const char* kChroma = R"(#version 300 es
+precision highp float;
+uniform sampler2D uSrc;
+uniform float uVu;
+in highp vec2 vUv;
+out vec4 oColor;
+void main() {
+    vec3 rgb = texture(uSrc, vUv).bgr;
+    float u = dot(rgb, vec3(-0.1484375, -0.2890625, 0.4375)) + 0.5;
+    float v = dot(rgb, vec3(0.4375, -0.3671875, -0.0703125)) + 0.5;
+    oColor = uVu > 0.5 ? vec4(v, u, 0.0, 1.0) : vec4(u, v, 0.0, 1.0);
+}
+)";
+
+// from an NV12 source: the luma plane (R8) and the chroma plane (RG88: U, V) scaled as they are
+const char* kLumaNv12 = R"(#version 300 es
+precision highp float;
+uniform sampler2D uSrc;
+in highp vec2 vUv;
+out vec4 oColor;
+void main() {
+    oColor = vec4(texture(uSrc, vUv).r, 0.0, 0.0, 1.0);
+}
+)";
+const char* kChromaNv12 = R"(#version 300 es
+precision highp float;
+uniform sampler2D uSrc;
+uniform float uVu;
+in highp vec2 vUv;
+out vec4 oColor;
+void main() {
+    vec2 c = texture(uSrc, vUv).rg;
+    oColor = uVu > 0.5 ? vec4(c.g, c.r, 0.0, 1.0) : vec4(c.r, c.g, 0.0, 1.0);
+}
+)";
+
+GLuint compile(GLenum type, const char* src) {
+    GLuint s = glCreateShader(type);
+    glShaderSource(s, 1, &src, nullptr);
+    glCompileShader(s);
+    GLint ok = 0;
+    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[512];
+        glGetShaderInfoLog(s, sizeof(log), nullptr, log);
+        ALOGE("shader: %s", log);
+        glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+GLuint link(const char* frag) {
+    GLuint vs = compile(GL_VERTEX_SHADER, kVertex), fs = compile(GL_FRAGMENT_SHADER, frag);
+    if (!vs || !fs) return 0;
+    GLuint p = glCreateProgram();
+    glAttachShader(p, vs);
+    glAttachShader(p, fs);
+    glLinkProgram(p);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        glDeleteProgram(p);
+        return 0;
+    }
+    return p;
+}
+
+bool hasExtension(const char* list, const char* name) {
+    if (list == nullptr) return false;
+    std::string l = std::string(" ") + list + " ";
+    return l.find(std::string(" ") + name + " ") != std::string::npos;
+}
+
+}  // namespace
+
+ExternalCameraGpu::~ExternalCameraGpu() {
+    if (mDisplay == EGL_NO_DISPLAY) return;
+    eglMakeCurrent(mDisplay, mSurface, mSurface, mContext);
+    clearCache();
+    if (mSrc) glDeleteTextures(1, &mSrc);
+    for (GLuint p : mProgram) {
+        if (p) glDeleteProgram(p);
+    }
+    eglMakeCurrent(mDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (mContext != EGL_NO_CONTEXT) eglDestroyContext(mDisplay, mContext);
+    if (mSurface != EGL_NO_SURFACE) eglDestroySurface(mDisplay, mSurface);
+    eglTerminate(mDisplay);
+}
+
+bool ExternalCameraGpu::init() {
+    mDisplay = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (mDisplay == EGL_NO_DISPLAY || !eglInitialize(mDisplay, nullptr, nullptr)) {
+        ALOGW("no EGL display");
+        mDisplay = EGL_NO_DISPLAY;
+        return false;
+    }
+    // Android's EGL loader advertises only the extensions it knows: dma-buf import (EGL_LINUX_DMA_BUF_EXT images)
+    // goes through to the driver (Mesa) without being listed; an import that fails falls back per buffer
+    const char* ext = eglQueryString(mDisplay, EGL_EXTENSIONS);
+    const bool surfaceless = hasExtension(ext, "EGL_KHR_surfaceless_context");
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint cfgAttrs[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT_KHR, EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+                               EGL_NONE};
+    EGLConfig cfg;
+    EGLint n = 0;
+    if (!eglChooseConfig(mDisplay, cfgAttrs, &cfg, 1, &n) || n < 1) {
+        ALOGW("no GLES3 config");
+        return false;
+    }
+    const EGLint ctxAttrs[] = {EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE};
+    mContext = eglCreateContext(mDisplay, cfg, EGL_NO_CONTEXT, ctxAttrs);
+    if (!surfaceless) {
+        // a 1x1 pbuffer to be current with (all rendering goes to the buffers' framebuffers)
+        const EGLint pbAttrs[] = {EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE};
+        mSurface = eglCreatePbufferSurface(mDisplay, cfg, pbAttrs);
+    }
+    if (mContext == EGL_NO_CONTEXT ||
+        !eglMakeCurrent(mDisplay, mSurface, mSurface, mContext)) {
+        ALOGW("no GLES3 context");
+        return false;
+    }
+    mCreateImage = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    mDestroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    mImageTargetTexture = reinterpret_cast<PFNGLEGLIMAGETARGETTEXTURE2DOESPROC>(
+            eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+    if (!mCreateImage || !mDestroyImage || !mImageTargetTexture) {
+        ALOGW("no EGLImage entry points");
+        return false;
+    }
+    const char* frags[4] = {kLuma, kChroma, kLumaNv12, kChromaNv12};
+    for (int i = 0; i < 4; i++) {
+        mProgram[i] = link(frags[i]);
+        if (!mProgram[i]) return false;
+        mCrop[i] = glGetUniformLocation(mProgram[i], "uCrop");
+        mVu[i] = glGetUniformLocation(mProgram[i], "uVu");
+        glUseProgram(mProgram[i]);
+        glUniform1i(glGetUniformLocation(mProgram[i], "uSrc"), 0);
+    }
+    glGenTextures(1, &mSrc);
+    glBindTexture(GL_TEXTURE_2D, mSrc);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    ALOGI("GPU conversion: %s", reinterpret_cast<const char*>(glGetString(GL_RENDERER)));
+    return true;
+}
+
+bool ExternalCameraGpu::upload(const uint8_t* data, int width, int height) {
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, mSrc);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    if (width != mSrcWidth || height != mSrcHeight) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        mSrcWidth = width;
+        mSrcHeight = height;
+    }
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, data);
+    mNv12 = false;
+    return glGetError() == GL_NO_ERROR;
+}
+
+bool ExternalCameraGpu::setSource(const Source& s) {
+    if (s.width < 2 || s.height < 2) return false;
+    Import* im = importSource(s);
+    if (im == nullptr) return false;
+    mSrcPlane[0] = im->tex[0];
+    mSrcPlane[1] = im->tex[1];
+    mSrcWidth = s.width;
+    mSrcHeight = s.height;
+    mNv12 = true;
+    return true;
+}
+
+ExternalCameraGpu::Import* ExternalCameraGpu::importSource(const Source& s) {
+    auto it = mSources.find(s.key);
+    if (it != mSources.end()) return &it->second;
+    if (mSources.size() >= 16) {
+        for (auto& [key, im] : mSources) release(im);
+        mSources.clear();
+    }
+    Import im;
+    for (int plane = 0; plane < 2; plane++) {
+        const EGLint attrs[] = {
+                EGL_WIDTH, static_cast<EGLint>(plane ? s.width / 2 : s.width),
+                EGL_HEIGHT, static_cast<EGLint>(plane ? s.height / 2 : s.height),
+                EGL_LINUX_DRM_FOURCC_EXT, static_cast<EGLint>(plane ? DRM_FORMAT_GR88 : DRM_FORMAT_R8),
+                EGL_DMA_BUF_PLANE0_FD_EXT, s.fd,
+                EGL_DMA_BUF_PLANE0_OFFSET_EXT, static_cast<EGLint>(plane ? s.cOffset : 0),
+                EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(s.stride),
+                EGL_NONE};
+        im.image[plane] = mCreateImage(mDisplay, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+        if (im.image[plane] == EGL_NO_IMAGE_KHR) {
+            ALOGW("cannot import plane %d of a %ux%u capture buffer (0x%x)", plane, s.width, s.height,
+                  eglGetError());
+            release(im);
+            return nullptr;
+        }
+        glGenTextures(1, &im.tex[plane]);
+        glBindTexture(GL_TEXTURE_2D, im.tex[plane]);
+        mImageTargetTexture(GL_TEXTURE_2D, im.image[plane]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+    return &mSources.emplace(s.key, im).first->second;
+}
+
+ExternalCameraGpu::Import* ExternalCameraGpu::importTarget(const Target& t) {
+    auto it = mImports.find(t.key);
+    if (it != mImports.end()) return &it->second;
+    // buffers come and go with the streams: keep the imports bounded
+    if (mImports.size() >= 64) clearCache();
+    Import im;
+    for (int plane = 0; plane < 2; plane++) {
+        const EGLint attrs[] = {
+                EGL_WIDTH, static_cast<EGLint>(plane ? t.width / 2 : t.width),
+                EGL_HEIGHT, static_cast<EGLint>(plane ? t.height / 2 : t.height),
+                EGL_LINUX_DRM_FOURCC_EXT, static_cast<EGLint>(plane ? DRM_FORMAT_GR88 : DRM_FORMAT_R8),
+                EGL_DMA_BUF_PLANE0_FD_EXT, t.fd,
+                EGL_DMA_BUF_PLANE0_OFFSET_EXT, static_cast<EGLint>(plane ? t.cOffset : t.yOffset),
+                EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(plane ? t.cStride : t.yStride),
+                EGL_NONE};
+        im.image[plane] = mCreateImage(mDisplay, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+        if (im.image[plane] == EGL_NO_IMAGE_KHR) {
+            ALOGW("cannot import plane %d of a %ux%u buffer (0x%x)", plane, t.width, t.height, eglGetError());
+            release(im);
+            return nullptr;
+        }
+        glGenTextures(1, &im.tex[plane]);
+        glBindTexture(GL_TEXTURE_2D, im.tex[plane]);
+        mImageTargetTexture(GL_TEXTURE_2D, im.image[plane]);
+        glGenFramebuffers(1, &im.fbo[plane]);
+        glBindFramebuffer(GL_FRAMEBUFFER, im.fbo[plane]);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, im.tex[plane], 0);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+            ALOGW("plane %d of a %ux%u buffer is not renderable", plane, t.width, t.height);
+            release(im);
+            return nullptr;
+        }
+    }
+    return &mImports.emplace(t.key, im).first->second;
+}
+
+bool ExternalCameraGpu::convert(const Target& t, int cx, int cy, int cw, int ch) {
+    if (mSrcWidth == 0 || t.width < 2 || t.height < 2) return false;
+    Import* im = importTarget(t);
+    if (im == nullptr) return false;
+    const float crop[4] = {static_cast<float>(cx) / mSrcWidth, static_cast<float>(cy) / mSrcHeight,
+                           static_cast<float>(cx + cw) / mSrcWidth,
+                           static_cast<float>(cy + ch) / mSrcHeight};
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, mSrc);
+    glDisable(GL_BLEND);
+    for (int plane = 0; plane < 2; plane++) {
+        const int prog = mNv12 ? 2 + plane : plane;
+        if (mNv12) glBindTexture(GL_TEXTURE_2D, mSrcPlane[plane]);
+        glBindFramebuffer(GL_FRAMEBUFFER, im->fbo[plane]);
+        glViewport(0, 0, plane ? t.width / 2 : t.width, plane ? t.height / 2 : t.height);
+        glUseProgram(mProgram[prog]);
+        glUniform4fv(mCrop[prog], 1, crop);
+        if (plane) glUniform1f(mVu[prog], t.vu ? 1.0f : 0.0f);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    return glGetError() == GL_NO_ERROR;
+}
+
+void ExternalCameraGpu::finish() {
+    glFinish();
+}
+
+void ExternalCameraGpu::release(Import& im) {
+    for (int plane = 0; plane < 2; plane++) {
+        if (im.fbo[plane]) glDeleteFramebuffers(1, &im.fbo[plane]);
+        if (im.tex[plane]) glDeleteTextures(1, &im.tex[plane]);
+        if (im.image[plane] != EGL_NO_IMAGE_KHR) mDestroyImage(mDisplay, im.image[plane]);
+    }
+    im = {};
+}
+
+void ExternalCameraGpu::clearCache() {
+    for (auto& [key, im] : mImports) release(im);
+    mImports.clear();
+    for (auto& [key, im] : mSources) release(im);
+    mSources.clear();
+    mNv12 = false;
+}
