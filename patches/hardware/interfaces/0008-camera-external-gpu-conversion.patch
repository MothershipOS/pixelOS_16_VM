+/*
+ * mothershipOS: the external camera HAL's per-stream conversion on the GPU.
+ *
+ * The source frame is either the capture buffer itself (NV12, the HAL's own gralloc buffer a mothershipOS host
+ * renders into: its planes sampled as R8 and RG88 dma-buf images, no CPU involved) or an uploaded XBGR32 frame
+ * (RGB to BT.601 YUV with the coefficients of libyuv's ARGBToI420, so the GPU and CPU paths look the same). Every
+ * semi-planar YUV output buffer (NV12/NV21, a gralloc buffer imported as dma-buf planes: an R8 target and an RG88
+ * one at half size) is rendered from it: crop to the output's aspect ratio, scale.
+ */
+
+#pragma once
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+
