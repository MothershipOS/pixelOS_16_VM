+// mothershipOS: the GPU path, made on the output thread (its EGL context lives there).
+// ro.vendor.camera.external.gpu=false keeps the CPU path.
+bool ExternalCameraDeviceSession::OutputThread::gpuReady() {
+    if (!mGpuTried) {
+        mGpuTried = true;
+        if (property_get_bool("ro.vendor.camera.external.gpu", true)) {
+            mGpu = std::make_unique<ExternalCameraGpu>();
+            if (!mGpu->init()) {
+                ALOGW("%s: no GPU conversion, the CPU converts", __FUNCTION__);
+                mGpu.reset();
+            }
+        }
+    }
+    return mGpu != nullptr;
+}
+
+// mothershipOS: render the uploaded frame into a semi-planar YUV output buffer (its plane layout learned once,
+// from a CPU lock). false: not on the GPU (planar, not importable, an error): the CPU path does it.
+bool ExternalCameraDeviceSession::OutputThread::gpuConvert(HalStreamBuffer& halBuf) {
+    buffer_handle_t handle = *(halBuf.bufPtr);
+    if (handle == nullptr || handle->numFds < 1) return false;
+    const int fd = handle->data[0];
+    struct stat st;
+    if (fstat(fd, &st) != 0) return false;
+    const uint64_t key = st.st_ino;
+    auto it = mGpuLayouts.find(key);
+    if (it == mGpuLayouts.end()) {
+        if (mGpuLayouts.size() >= 64) mGpuLayouts.clear();
+        GpuLayout l{};
+        android::Rect rect{0, 0, static_cast<int32_t>(halBuf.width), static_cast<int32_t>(halBuf.height)};
+        uint8_t* base = static_cast<uint8_t*>(
+                sHandleImporter.lock(handle, static_cast<uint64_t>(halBuf.usage), rect));
+        sHandleImporter.unlock(handle);
+        android_ycbcr y = sHandleImporter.lockYCbCr(handle, static_cast<uint64_t>(halBuf.usage), rect);
+        sHandleImporter.unlock(handle);
+        if (base != nullptr && y.y != nullptr && y.chroma_step == 2) {
+            uint8_t* c = static_cast<uint8_t*>(std::min(y.cb, y.cr));
+            l = {.ok = true,
+                 .yOffset = static_cast<uint32_t>(static_cast<uint8_t*>(y.y) - base),
+                 .yStride = static_cast<uint32_t>(y.ystride),
+                 .cOffset = static_cast<uint32_t>(c - base),
+                 .cStride = static_cast<uint32_t>(y.cstride),
+                 .vu = y.cr < y.cb};
+        }
+        it = mGpuLayouts.emplace(key, l).first;
+    }
+    if (!it->second.ok) return false;
+    const GpuLayout& l = it->second;
+    IMapper::Rect crop;
+    if (getCropRect(mCroppingType,
+                    Size{static_cast<int32_t>(mYu12Frame->mWidth), static_cast<int32_t>(mYu12Frame->mHeight)},
+                    Size{static_cast<int32_t>(halBuf.width), static_cast<int32_t>(halBuf.height)}, &crop) != 0) {
+        return false;
+    }
+    ExternalCameraGpu::Target t{.fd = fd, .width = static_cast<uint32_t>(halBuf.width),
+                                .height = static_cast<uint32_t>(halBuf.height),
+                                .yOffset = l.yOffset, .yStride = l.yStride, .cOffset = l.cOffset,
+                                .cStride = l.cStride, .vu = l.vu, .key = key};
+    ATRACE_BEGIN("gpuConvert");
+    bool ok = mGpu->convert(t, crop.left, crop.top, crop.width, crop.height);
+    ATRACE_END();
+    if (!ok) mGpuLayouts[key].ok = false;  // this buffer stays on the CPU
+    return ok;
+}
