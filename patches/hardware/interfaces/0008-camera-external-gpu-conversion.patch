+void ExternalCameraDeviceSession::setV4l2Memory(v4l2_buffer* b) const {
+    b->memory = v4l2Memory();
+    if (mDmabufCapture && b->index < mCaptureBuffers.size()) {
+        b->m.fd = mCaptureBuffers[b->index].fd;
+        b->length = mCaptureBuffers[b->index].length;
+    }
 }
 
