+class ExternalCameraGpu {
+  public:
+    ExternalCameraGpu() = default;
+    ~ExternalCameraGpu();
+    ExternalCameraGpu(const ExternalCameraGpu&) = delete;
+    ExternalCameraGpu& operator=(const ExternalCameraGpu&) = delete;
+
+    // EGL display and context (surfaceless), shaders. false: no GPU path (the CPU path is used).
+    bool init();
+    // The frame for the following conversions: XBGR32 (B, G, R, X in memory), tightly packed.
+    bool upload(const uint8_t* data, int width, int height);
+
+    // Or an NV12 dma-buf (the capture buffer), sampled where it is.
+    struct Source {
+        int fd;
+        uint32_t width, height;
+        uint32_t stride, cOffset;  // luma stride (also the chroma's), the chroma plane's offset
+        uint64_t key;              // the buffer's identity, for the cached imports
+    };
+    bool setSource(const Source& s);
+
+    struct Target {
+        int fd;            // the buffer's dma-buf
+        uint32_t width, height;
+        uint32_t yOffset, yStride;
+        uint32_t cOffset, cStride;  // the chroma plane (interleaved)
+        bool vu;           // NV21 (V first)
+        uint64_t key;      // the buffer's identity, for the cached imports
+    };
+    // Render the uploaded frame, cropped to (cx, cy, cw, ch) of it, into the target.
+    bool convert(const Target& t, int cx, int cy, int cw, int ch);
+    // Wait for the GPU (the buffers are complete when this returns).
+    void finish();
+    // Drop the cached buffer imports (the streams changed).
+    void clearCache();
+
+  private:
+    struct Import {
+        EGLImageKHR image[2] = {EGL_NO_IMAGE_KHR, EGL_NO_IMAGE_KHR};
+        GLuint tex[2] = {0, 0};
+        GLuint fbo[2] = {0, 0};
+    };
+    Import* importTarget(const Target& t);
+    Import* importSource(const Source& s);
+    void release(Import& im);
+
+    EGLDisplay mDisplay = EGL_NO_DISPLAY;
+    EGLContext mContext = EGL_NO_CONTEXT;
+    EGLSurface mSurface = EGL_NO_SURFACE;
+    GLuint mProgram[4] = {0, 0, 0, 0};  // from RGB: Y, chroma; from NV12: Y, chroma
+    GLint mCrop[4] = {-1, -1, -1, -1};
+    GLint mVu[4] = {-1, -1, -1, -1};
+    bool mNv12 = false;  // the source is an NV12 buffer (setSource), its planes' textures:
+    GLuint mSrcPlane[2] = {0, 0};
+    std::map<uint64_t, Import> mSources;
+    GLuint mSrc = 0;
+    int mSrcWidth = 0, mSrcHeight = 0;
+    std::map<uint64_t, Import> mImports;
+    PFNEGLCREATEIMAGEKHRPROC mCreateImage = nullptr;
+    PFNEGLDESTROYIMAGEKHRPROC mDestroyImage = nullptr;
+    PFNGLEGLIMAGETARGETTEXTURE2DOESPROC mImageTargetTexture = nullptr;
+};
