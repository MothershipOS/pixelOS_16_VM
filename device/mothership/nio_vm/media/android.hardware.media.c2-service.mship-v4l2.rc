# mship.video: the V4L2 Codec2 components (host Venus decoder through virtio-media)
service vendor.media.c2-v4l2 /vendor/bin/hw/android.hardware.media.c2-service.mship-v4l2
    class hal
    user mediacodec
    group camera mediadrm drmrpc graphics
    ioprio rt 4
    task_profiles ProcessCapacityHigh
